# Browser-visible Supabase project configuration; use separate local and cloud projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credentials. Never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=your-server-secret-key
BFL_API_KEY=your-bfl-key
ANTHROPIC_API_KEY=your-anthropic-key

# Pinned runtime models. FLUX.2 pro is the supported higher-quality alternative.
BFL_MODEL=flux-2-klein-9b
ANTHROPIC_MODEL=claude-haiku-5-5

# Count limits, not guaranteed monetary spending caps. Retries count toward these.
DAILY_USER_AI_LIMIT=50
DAILY_GLOBAL_AI_LIMIT=200
MAX_INVENTORY_ITEMS=1000

# Optional maintenance endpoint authentication, if a schedule is configured.
CRON_SECRET=replace-with-a-long-random-secret
