{
  "name": "poof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "db:start": "supabase start --exclude studio,realtime,edge-runtime,logflare,vector,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed",
    "dev:setup": "node scripts/local-env.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:ai": "node scripts/verify-api.mjs --live-ai",
    "verify:maintenance": "node scripts/verify-maintenance.mjs",
    "verify:scaling": "node scripts/verify-scaling.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "heic2any": "0.0.4",
    "lucide-react": "0.556.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "workflow": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "overrides": {
    "devalue": "5.9.4",
    "nanoid@5.1.6": "5.1.16",
    "zod": "$zod",
    "undici@^7.0.0": "7.30.1"
  }
}
